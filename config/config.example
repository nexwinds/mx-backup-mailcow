# mx-backup-mailcow configuration
#
# This file is sourced by the application scripts. It is written by install.sh
# with mode 0600 and owned by root. Keep it readable by root only: it contains
# the Mailcow API key.
#
# Managed keys are rewritten by install.sh; extra lines are preserved.

# Postfix identity used for HELO, $myorigin and DSN senders. Must be a fully
# qualified domain name whose A/AAAA and PTR records point at this server.
BACKUP_MX_HOSTNAME="mx2.example.com"

# Mailcow hostname used for the API (no scheme, no path).
MAILCOW_HOST="mail.example.com"

# Dedicated read-only API key, restricted to this server's IP in Mailcow.
MAILCOW_API_KEY="replace-with-read-only-api-key"

# Optional private CA bundle used to verify the Mailcow API certificate.
MAILCOW_API_CA_FILE=""

# Primary Mailcow IP that queued mail is forwarded to.
MAILCOW_PRIMARY_IP="203.0.113.10"
MAILCOW_PRIMARY_PORT=25

# Outbound SMTP TLS policy to the primary: secure (default) or may.
# secure requires SMTP_TLS_MATCH_HOSTNAME and a certificate valid for it; it is
# the only mode in which the hop carrying queued mail is authenticated.
SMTP_TLS_MODE="secure"
SMTP_TLS_MATCH_HOSTNAME="mail.example.com"

# Inbound TLS material offered to sending MTAs. Point these at an existing
# renewal store (certbot's /etc/letsencrypt/live/<hostname>/): install.sh copies
# the chain and key into /etc/postfix/tls where the postfix user can read them,
# and installs a certbot deploy hook so renewals update the copies.
# Leave both empty and install.sh requests a Let's Encrypt certificate when the
# hostname resolves and TCP/80 is reachable. If that is not possible, port 25
# runs without STARTTLS (senders enforcing MTA-STS or DANE cannot deliver).
SMTPD_TLS_CERT_FILE=""
SMTPD_TLS_KEY_FILE=""

# Forward operational mail (root, postmaster, abuse, ...) to this address.
# Empty discards it, which is the default because this server stores no mail.
OPERATIONAL_MAIL_TO=""

# Space-separated domains to exclude from synchronization.
EXCLUDE_DOMAINS=""

# Accept every recipient of hosted domains after this many days without a
# successful API synchronization. 0 disables relaxation (always strict).
RELAX_AFTER_DAYS=7

# How long queued mail is kept while the primary is unavailable.
QUEUE_LIFETIME="7d"

# Maximum accepted message size in bytes (100 MB, matches Mailcow's default).
MESSAGE_SIZE_LIMIT=104857600
